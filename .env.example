# Google Apps Script Web App Endpoint URL (obtained after deploying Apps Script as Web App)
VITE_SHEETS_URL="https://script.google.com/macros/s/AKfycbx_EXAMPLE_ID/exec"

# Direct URL to the Google Sheet (for the "Open Sheet / Export" button)
VITE_SHEET_VIEW_URL="https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit"

# Optional Volunteer Security PIN (e.g. 2026). Leave empty or commented to disable PIN lock
VITE_ACCESS_PIN="2026"

# Event Identifier
VITE_EVENT_NAME="CTRL 2K26"
